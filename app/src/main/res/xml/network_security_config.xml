<?xml version="1.0" encoding="utf-8"?>
<!--
    网络安全配置。

    为什么需要它：
    Android 9（API 28）起默认禁止明文 HTTP。本地 ollama 通常是
    http://100.x.x.x:19931（Tailscale 内网地址），不是 HTTPS，
    不加这个配置请求会被系统直接拒绝（CLEARTEXT communication not permitted）。

    这里只放行**内网/环回**地址，其余一律仍强制 HTTPS：
    - 10.0.0.0/8        常见家庭/校园网段
    - 172.16.0.0/12     同上
    - 192.168.0.0/16    同上
    - 100.64.0.0/10     ← Tailscale 分配的地址就在这一段
    - localhost / 127.0.0.1  本机调试

    云端 API（api.deepseek.com 等）不在白名单里，所以仍然走 HTTPS，
    不会因为这里放开而降低云端链路的安全性。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="true">172.16.0.0</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">100.64.0.0</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
